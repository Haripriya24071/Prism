# ── Gemini AI Studio Multi-Key Pool (100% Free Forever) ──
GEMINI_API_KEY_1=your-gemini-key-1
GEMINI_API_KEY_2=your-gemini-key-2
# ... up to GEMINI_API_KEY_20

# Default Gemini model
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-flash

# ── GCP / Storage / BigQuery ────────────────────────────
GCP_PROJECT_ID=prism-hackathon-510523
GCP_REGION=us-central1
GCS_BUCKET_NAME=prism-outputs
BIGQUERY_DATASET=prism_data
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── External context APIs ───────────────────────────────
NEWSAPI_KEY=your-newsapi-key-here
CRUNCHBASE_KEY=your-crunchbase-key-here
ALPHAVANTAGE_KEY=your-alphavantage-key-here

# ── App settings ────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_TTL_SECONDS=7200
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
ENV=development
